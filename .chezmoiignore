# AGENTS.md, SYSTEM.md, keybindings.json, models.json, skills/, prompts/,
# extensions/, themes/.
.pi/agent/auth.json
.pi/agent/trust.json
.pi/agent/models-store.json
.pi/agent/sessions
.pi/agent/git
.pi/agent/npm
.pi/agent/pi-debug.log

# opencode runtime state — credentials, sessions, logs, caches.
# Config lives at ~/.config/opencode/opencode.json and IS managed; opencode
# only reads it, so it can be a normal managed file rather than a seed.
.local/share/opencode
.local/state/opencode
.cache/opencode
